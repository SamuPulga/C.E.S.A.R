[Unit]
Description=JARVIS Web Dashboard - panel de control de solo lectura
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samupulga
WorkingDirectory=/home/samupulga/jarvis
ExecStart=/home/samupulga/jarvis/venv/bin/uvicorn src.web.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
